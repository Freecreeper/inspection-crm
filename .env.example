# Copy to .env.local for local development (docker compose up -d starts postgres + redis)

DATABASE_URL="postgresql://inspection_crm:inspection_crm_dev@localhost:5432/inspection_crm?schema=public"

# Auth.js — generate with `npx auth secret`
AUTH_SECRET="replace-with-a-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

REDIS_URL="redis://localhost:6379"

# Object storage (Cloudflare R2 / S3-compatible) — required for media & report PDFs (§11, §12)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_HOSTNAME=""

# Email (see docs/email.md). Nothing is delivered unless EMAIL_DELIVERY_MODE
# is explicitly "live" (real recipients) or "redirect" (everything goes to
# EMAIL_REDIRECT_TO). Unset/"log" = simulated: full pipeline, no delivery.
EMAIL_DELIVERY_MODE="log"
EMAIL_REDIRECT_TO=""
# Default From address (must be a verified sender in Postmark). Can be
# overridden in Email → Settings.
EMAIL_FROM="noreply@example.com"
POSTMARK_API_TOKEN=""
POSTMARK_TRANSACTIONAL_STREAM="outbound"
POSTMARK_BROADCAST_STREAM="broadcast"
# Basic-auth credentials you also enter in Postmark's webhook URL:
# https://USER:PASS@your-host/api/webhooks/postmark
POSTMARK_WEBHOOK_USERNAME=""
POSTMARK_WEBHOOK_PASSWORD=""
# Public base URL used in secure report links and unsubscribe links.
APP_BASE_URL="http://localhost:3000"
# Time zone used for dates/times in emails and for birthday/anniversary days.
APP_TIMEZONE="America/New_York"
# Bearer secret for POST /api/cron/email (hosts without a long-running
# worker). Leave empty to disable the endpoint and use `npm run worker`.
EMAIL_WORKER_SECRET=""
EMAIL_WORKER_INTERVAL_MS="10000"
EMAIL_WORKER_BATCH="25"
