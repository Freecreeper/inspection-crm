// Data model for the Home Inspection CRM (Version 1).
// Mirrors the architecture proposal reviewed and approved by the business owner —
// section references (§N) point back to that document's numbering.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER_ADMIN
  INSPECTOR
  OFFICE_STAFF
  REPORTING_ANALYST
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum TransactionStatus {
  LEAD_IN_PROGRESS
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

// Non-Realtor transaction contacts (attorney, lender) are deferred — V1 keeps
// this relationship Realtor-specific rather than introducing a generic
// polymorphic "party" abstraction the business hasn't asked for yet (PR #1
// review item 2). Buyers/sellers are real Customer records via
// TransactionCustomer, never a Realtor row standing in for them.
enum RealtorParticipantRole {
  BUYER_AGENT
  LISTING_AGENT
  TRANSACTION_COORDINATOR
  OTHER
}

// Multiple independent Customers can be on one Transaction (e.g. two buyers),
// or zero. Among whichever Customers are on a transaction, at most one may
// have primaryContact = true — enforced in application code
// (addCustomerToTransaction, setPrimaryCustomer), the same way
// RealtorBrokerageHistory enforces "one open row" in application code rather
// than a DB constraint. See the fuller invariant note on TransactionCustomer
// itself (PR #1 review item 1; re-clarified in re-review item 1).
enum TransactionCustomerRole {
  PRIMARY_BUYER
  SECONDARY_BUYER
  SELLER
  OTHER
}

enum PreferredContactMethod {
  PHONE
  TEXT
  EMAIL
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// §"Inspection status for components" — distinguishes "not yet known" from
// "genuinely not applicable" so a blank field never has to be guessed at (§6).
enum ComponentInspectionStatus {
  INSPECTED
  NOT_INSPECTED
  NOT_PRESENT
  NOT_ACCESSIBLE
  LIMITED_INSPECTION
  NOT_APPLICABLE
}

enum ReportStatus {
  DRAFT
  IN_PROGRESS
  REVIEW_REQUIRED
  READY_FOR_REVIEW
  FINALIZED
  DELIVERED
  AMENDED
  ARCHIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CARD
  ACH
  CHECK
  CASH
  OTHER
}

enum DeliveryRecipientType {
  CUSTOMER
  SECONDARY_CUSTOMER
  REALTOR
  OTHER_AUTHORIZED
}

enum DeliveryStatus {
  PENDING
  SENT
  VIEWED
  FAILED
}

enum CustomFieldDataType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTISELECT
}

// The set of entities custom fields may attach to (§8). Kept as an enum, not a
// free string, because it's a deliberate architectural boundary, not user data.
enum CustomFieldEntityType {
  REPORT
  REPORT_SECTION
  REPORT_COMPONENT
  FINDING
  PROPERTY
  INSPECTION
  CUSTOMER
  TRANSACTION
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  name                   String
  passwordHash           String
  role                   Role     @default(OFFICE_STAFF)
  active                 Boolean  @default(true)
  // Which sections this user wants on the Realtor preview drawer, as an
  // allow-listed array of section keys (src/lib/realtors/previewLayout.ts).
  // NULL means "use the defaults".
  realtorPreviewSections Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  inspectionsAsInspector  Inspection[]       @relation("InspectorUser")
  tasksAssigned           Task[]
  activityLogs            ActivityLog[]
  automationEvents        AutomationEvent[]  @relation("TriggeredByUser")
  reportDefinitions       ReportDefinition[]
  narrativesCreated       Narrative[]
  reportVersionsFinalized ReportVersion[]    @relation("FinalizedByUser")

  @@map("users")
}

// ---------------------------------------------------------------------------
// CRM & transactions (§4 "Identity, CRM & transactions")
// ---------------------------------------------------------------------------

model Lead {
  id                  String          @id @default(cuid())
  firstName           String
  lastName            String
  email               String?
  phone               String?
  status              LeadStatus      @default(NEW)
  referralSourceId    String?
  referralSource      ReferralSource? @relation(fields: [referralSourceId], references: [id])
  convertedCustomerId String?         @unique
  convertedCustomer   Customer?       @relation("LeadConversion", fields: [convertedCustomerId], references: [id])
  convertedAt         DateTime?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status])
  @@map("leads")
}

model Customer {
  id         String    @id @default(cuid())
  firstName  String
  lastName   String
  email      String?
  phone      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  leadOrigin   Lead?                 @relation("LeadConversion")
  transactions TransactionCustomer[]

  @@map("customers")
}

model Property {
  id            String   @id @default(cuid())
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  zip           String
  county        String?
  yearBuilt     Int?
  squareFootage Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions Transaction[]
  inspections  Inspection[]

  @@index([city])
  @@index([zip])
  @@map("properties")
}

model Appointment {
  id            String       @id @default(cuid())
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  inspectionId  String?
  inspection    Inspection?  @relation(fields: [inspectionId], references: [id])
  title         String
  startAt       DateTime
  endAt         DateTime
  location      String?
  cancelledAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([startAt])
  @@map("appointments")
}

model Task {
  id            String       @id @default(cuid())
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  // Optional Realtor this task is a follow-up for — relationship tasks
  // ("thank-you after inspection") live in the same Task system as
  // transaction tasks rather than a separate Realtor-only one. A task may
  // have both, either, or neither.
  realtorId     String?
  realtor       Realtor?     @relation(fields: [realtorId], references: [id])
  assigneeId    String?
  assignee      User?        @relation(fields: [assigneeId], references: [id])
  title         String
  description   String?
  dueAt         DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([assigneeId])
  @@index([dueAt])
  @@index([realtorId, completedAt])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Relationship network (§4 "Relationship network")
// ---------------------------------------------------------------------------

model ReferralSource {
  id        String   @id @default(cuid())
  name      String
  type      String
  active    Boolean  @default(true)
  // Set when this source *is* a specific Realtor. This is the only thing
  // that attributes a referral to a Realtor — being a TransactionRealtor on
  // a deal never does (associated ≠ referred).
  realtorId String?
  realtor   Realtor? @relation(fields: [realtorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads        Lead[]
  transactions Transaction[]

  @@index([realtorId])
  @@map("referral_sources")
}

model Brokerage {
  id           String    @id @default(cuid())
  name         String
  phone        String?
  email        String?
  addressLine1 String?
  city         String?
  state        String?
  zip          String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  realtors            Realtor[]
  history             RealtorBrokerageHistory[]
  transactionRealtors TransactionRealtor[]

  @@map("brokerages")
}

model Realtor {
  id                     String                  @id @default(cuid())
  firstName              String
  lastName               String
  preferredName          String?
  email                  String?
  phone                  String?
  preferredContactMethod PreferredContactMethod?
  licenseNumber          String?
  notes                  String?
  brokerageId            String?
  brokerage              Brokerage?              @relation(fields: [brokerageId], references: [id])
  archivedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  transactions    TransactionRealtor[]
  history         RealtorBrokerageHistory[]
  referralSources ReferralSource[]
  tasks           Task[]
  communications  Communication[]

  @@index([lastName, firstName])
  @@index([brokerageId])
  @@index([email])
  @@index([phone])
  @@map("realtors")
}

// Tracks a realtor changing firms over time so a past transaction still shows
// the brokerage that was actually current on it (§4).
model RealtorBrokerageHistory {
  id          String    @id @default(cuid())
  realtorId   String
  realtor     Realtor   @relation(fields: [realtorId], references: [id])
  brokerageId String
  brokerage   Brokerage @relation(fields: [brokerageId], references: [id])
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  @@index([realtorId])
  @@map("realtor_brokerage_history")
}

model Communication {
  id            String       @id @default(cuid())
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  // Optional Realtor the communication was with — lets a call/email be
  // logged against the relationship itself, not only against a deal.
  realtorId     String?
  realtor       Realtor?     @relation(fields: [realtorId], references: [id])
  channel       String
  direction     String
  summary       String
  occurredAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@index([transactionId])
  @@index([realtorId])
  @@map("communications")
}

model Document {
  id            String       @id @default(cuid())
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  title         String
  storageKey    String
  fileType      String
  uploadedById  String?
  createdAt     DateTime     @default(now())

  @@index([transactionId])
  @@map("documents")
}

// No scalar customerId/primaryCustomerId here on purpose (PR #1 review item 1):
// a Transaction may start with zero Customers, and a second FK duplicating
// "who's primary" would be a second source of truth alongside
// TransactionCustomer.primaryContact that could drift from it. Callers read
// the primary contact through the customers relation (see
// src/lib/transactions.ts#getPrimaryCustomer) instead.
model Transaction {
  id               String            @id @default(cuid())
  propertyId       String?
  property         Property?         @relation(fields: [propertyId], references: [id])
  referralSourceId String?
  referralSource   ReferralSource?   @relation(fields: [referralSourceId], references: [id])
  status           TransactionStatus @default(LEAD_IN_PROGRESS)
  closingDate      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  customers      TransactionCustomer[]
  realtors       TransactionRealtor[]
  inspections    Inspection[]
  invoices       Invoice[]
  appointments   Appointment[]
  tasks          Task[]
  communications Communication[]
  documents      Document[]

  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

// Normalized Customer <-> Transaction relationship (PR #1 review item 1) —
// supports multiple independent Customers on one Transaction (e.g. two
// buyers) without duplicating Customer records.
//
// Primary-contact invariant: a Transaction may have zero Customers (the
// non-blocking, incomplete-data philosophy applies here too — see §7 and
// createTransaction). Among whichever Customers *are* associated with a
// Transaction, at most one may be designated primaryContact. Customers with
// no primary contact selected yet are valid and expected; the UI may surface
// that as a data-quality warning, but it never blocks the rest of the
// transaction workflow.
//
// This uniqueness rule (at most one primaryContact per transactionId) is
// currently enforced only in application logic (addCustomerToTransaction,
// setPrimaryCustomer), not by the database — Prisma's schema language has no
// partial-unique-index syntax, and a plain @@unique on transactionId would
// defeat the point (it would cap every transaction at one customer, full
// stop). Technical note: if this invariant needs DB-level enforcement later,
// a PostgreSQL partial unique index is the right tool —
//   CREATE UNIQUE INDEX transaction_customers_one_primary_idx
//     ON transaction_customers (transaction_id) WHERE primary_contact = true;
// — added by hand to a migration, since Prisma can't express it declaratively
// in schema.prisma; the schema and the migration would then intentionally
// diverge on this one index, which is worth a comment at the point it's added.
//
// Deliberately not solved by adding a primaryCustomerId scalar to
// Transaction: a second FK duplicating "who's primary" would be a second
// source of truth alongside primaryContact that could drift from it.
model TransactionCustomer {
  id             String                  @id @default(cuid())
  transactionId  String
  transaction    Transaction             @relation(fields: [transactionId], references: [id])
  customerId     String
  customer       Customer                @relation(fields: [customerId], references: [id])
  role           TransactionCustomerRole @default(OTHER)
  primaryContact Boolean                 @default(false)
  createdAt      DateTime                @default(now())

  @@unique([transactionId, customerId])
  @@index([transactionId])
  @@index([customerId])
  @@map("transaction_customers")
}

// Resolves the Realtor <-> Transaction many-to-many relationship (Fig. 2).
// Realtor-specific by design (PR #1 review item 2) — the old
// TransactionParticipant mixed a nullable realtorId FK with a role enum that
// also claimed BUYER/SELLER/ATTORNEY/LENDER, which meant a "BUYER" row had no
// actual buyer behind it. Customer-side participants are TransactionCustomer
// rows now; this table only ever points at a real Realtor.
model TransactionRealtor {
  id            String                 @id @default(cuid())
  transactionId String
  transaction   Transaction            @relation(fields: [transactionId], references: [id])
  realtorId     String
  realtor       Realtor                @relation(fields: [realtorId], references: [id])
  role          RealtorParticipantRole
  // Snapshot of the realtor's brokerage at the moment they were added to
  // *this* transaction (PR #1 review item 5). A transaction spans weeks, so
  // "the brokerage at the time of the transaction" has no single instant to
  // resolve a RealtorBrokerageHistory date-range lookup against — but "the
  // brokerage when this realtor was actually attached to this deal" is a
  // concrete event, so we snapshot it here instead, the same pattern
  // InvoiceItem already uses for historical pricing.
  brokerageId   String?
  brokerage     Brokerage?             @relation(fields: [brokerageId], references: [id])
  brokerageName String?
  createdAt     DateTime               @default(now())

  @@index([transactionId])
  @@index([realtorId])
  @@map("transaction_realtors")
}

// ---------------------------------------------------------------------------
// Service delivery & billing (§4 "Service delivery & billing")
// ---------------------------------------------------------------------------

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inspectionServices InspectionService[]

  @@map("services")
}

model Inspection {
  id              String           @id @default(cuid())
  transactionId   String
  transaction     Transaction      @relation(fields: [transactionId], references: [id])
  propertyId      String
  property        Property         @relation(fields: [propertyId], references: [id])
  inspectorId     String?
  inspector       User?            @relation("InspectorUser", fields: [inspectorId], references: [id])
  status          InspectionStatus @default(SCHEDULED)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  weather         String?
  temperatureF    Int?
  occupancyStatus String?
  utilitiesOn     Boolean?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  inspectionServices InspectionService[]
  reports            InspectionReport[]
  invoices           Invoice[]
  media              Media[]
  appointments       Appointment[]

  @@index([status])
  @@index([scheduledAt])
  @@map("inspections")
}

model InspectionService {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id])
  serviceId    String
  service      Service    @relation(fields: [serviceId], references: [id])
  price        Decimal    @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())

  @@index([inspectionId])
  @@map("inspection_services")
}

// Anchored to Transaction, not Inspection (PR #1 review item 6) — the
// approved architecture treats Transaction as the operational hub with
// potentially multiple Inspections and services on it, so a 1:1
// Invoice<->Inspection unique FK couldn't represent one invoice covering
// several inspection services, an additional invoice for a reinspection, or
// an adjustment invoice. inspectionId is now optional and non-unique: an
// invoice may still reference the specific inspection it bills for, but
// doesn't have to, and more than one invoice may reference the same one.
model Invoice {
  id            String        @id @default(cuid())
  transactionId String
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  inspectionId  String?
  inspection    Inspection?   @relation(fields: [inspectionId], references: [id])
  status        InvoiceStatus @default(DRAFT)
  invoiceNumber String        @unique
  issuedAt      DateTime?
  dueAt         DateTime?
  voidedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([status])
  @@index([transactionId])
  @@index([inspectionId])
  @@map("invoices")
}

// Kept separate from InspectionService so historical pricing survives a later
// change to the service price list (§4).
model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  description String
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  reference String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  @@index([invoiceId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Inspection report engine (§4 "Inspection report engine", §10)
// ---------------------------------------------------------------------------

model ReportTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections TemplateSection[]
  reports  InspectionReport[]

  @@map("report_templates")
}

model TemplateSection {
  id           String         @id @default(cuid())
  templateId   String
  template     ReportTemplate @relation(fields: [templateId], references: [id])
  name         String
  displayOrder Int            @default(0)
  active       Boolean        @default(true)

  components TemplateComponent[]

  @@index([templateId])
  @@map("template_sections")
}

model TemplateComponent {
  id                String          @id @default(cuid())
  templateSectionId String
  templateSection   TemplateSection @relation(fields: [templateSectionId], references: [id])
  name              String
  displayOrder      Int             @default(0)
  active            Boolean         @default(true)

  @@index([templateSectionId])
  @@map("template_components")
}

model InspectionReport {
  id                  String          @id @default(cuid())
  inspectionId        String
  inspection          Inspection      @relation(fields: [inspectionId], references: [id])
  templateId          String?
  template            ReportTemplate? @relation(fields: [templateId], references: [id])
  reportNumber        String          @unique
  status              ReportStatus    @default(DRAFT)
  title               String?
  introduction        String?
  scope               String?
  limitations         String?
  footer              String?
  internalNotes       String?
  customerFacingNotes String?
  finalizedAt         DateTime?
  finalizedById       String?
  deliveredAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  sections     ReportSection[]
  summaryItems ReportSummaryItem[]
  versions     ReportVersion[]
  deliveries   ReportDelivery[]
  media        Media[]

  @@index([status])
  @@map("inspection_reports")
}

model ReportSection {
  id               String           @id @default(cuid())
  reportId         String
  report           InspectionReport @relation(fields: [reportId], references: [id])
  name             String
  description      String?
  displayOrder     Int              @default(0)
  notApplicable    Boolean          @default(false)
  defaultNarrative String?

  components ReportComponent[]

  @@index([reportId])
  @@map("report_sections")
}

model ReportComponent {
  id               String                    @id @default(cuid())
  sectionId        String
  section          ReportSection             @relation(fields: [sectionId], references: [id])
  name             String
  materialType     String?
  inspectionStatus ComponentInspectionStatus @default(NOT_INSPECTED)
  limitationNote   String?
  notes            String?
  displayOrder     Int                       @default(0)

  findings Finding[]

  @@index([sectionId])
  @@map("report_components")
}

// Company-configurable classification terminology (§ "Finding classification") —
// never a hard-coded severity scale.
model FindingCategory {
  id           String  @id @default(cuid())
  key          String  @unique
  label        String
  description  String?
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  findings Finding[]

  @@map("finding_categories")
}

// Library entries are copied into a Finding on insert (Fig. 3) — editing a
// finding never mutates the shared entry.
model Narrative {
  id                 String   @id @default(cuid())
  title              String
  sectionHint        String?
  componentHint      String?
  narrativeText      String
  recommendationText String?
  active             Boolean  @default(true)
  createdById        String?
  createdBy          User?    @relation(fields: [createdById], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("narratives")
}

model Finding {
  id                      String           @id @default(cuid())
  componentId             String
  component               ReportComponent  @relation(fields: [componentId], references: [id])
  categoryId              String?
  category                FindingCategory? @relation(fields: [categoryId], references: [id])
  title                   String
  description             String
  location                String?
  recommendation          String?
  recommendedProfessional String?
  safetyRelated           Boolean          @default(false)
  repairRecommended       Boolean          @default(false)
  monitor                 Boolean          @default(false)
  furtherEvaluation       Boolean          @default(false)
  includedInSummary       Boolean          @default(false)
  inspectorNotes          String?
  displayOrder            Int              @default(0)
  createdById             String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  media       Media[]
  summaryItem ReportSummaryItem?

  @@index([componentId])
  @@index([categoryId])
  @@map("findings")
}

// Bytes live in object storage — this table is metadata only (§11).
model Media {
  id               String            @id @default(cuid())
  inspectionId     String
  inspection       Inspection        @relation(fields: [inspectionId], references: [id])
  reportId         String?
  report           InspectionReport? @relation(fields: [reportId], references: [id])
  findingId        String?
  finding          Finding?          @relation(fields: [findingId], references: [id])
  storageKey       String
  derivativeKey    String?
  fileType         String
  originalFileName String?
  caption          String?
  displayOrder     Int               @default(0)
  includeInReport  Boolean           @default(true)
  uploadedById     String?
  createdAt        DateTime          @default(now())

  @@index([inspectionId])
  @@index([findingId])
  @@map("media")
}

// Derived automatically from inspector-approved findings — never AI-classified (§21).
model ReportSummaryItem {
  id           String           @id @default(cuid())
  reportId     String
  report       InspectionReport @relation(fields: [reportId], references: [id])
  findingId    String           @unique
  finding      Finding          @relation(fields: [findingId], references: [id])
  groupLabel   String
  displayOrder Int              @default(0)

  @@index([reportId])
  @@map("report_summary_items")
}

// One immutable row per finalize/amend — Version 1 is never overwritten (§10, §15).
model ReportVersion {
  id                String           @id @default(cuid())
  reportId          String
  report            InspectionReport @relation(fields: [reportId], references: [id])
  versionNumber     Int
  snapshot          Json
  pdfStorageKey     String?
  reasonForRevision String?
  createdById       String?
  createdBy         User?            @relation("FinalizedByUser", fields: [createdById], references: [id])
  finalizedAt       DateTime         @default(now())

  deliveries ReportDelivery[]

  @@unique([reportId, versionNumber])
  @@map("report_versions")
}

// Delivery-scoped access token, independent of staff auth (§16).
model ReportDelivery {
  id              String                @id @default(cuid())
  reportId        String
  report          InspectionReport      @relation(fields: [reportId], references: [id])
  versionId       String
  version         ReportVersion         @relation(fields: [versionId], references: [id])
  recipientType   DeliveryRecipientType
  recipientName   String
  recipientEmail  String
  deliveryMethod  String                @default("email")
  status          DeliveryStatus        @default(PENDING)
  deliveredAt     DateTime?
  deliveredById   String?
  accessTokenHash String                @unique
  accessExpiresAt DateTime

  @@index([reportId])
  @@map("report_deliveries")
}

// ---------------------------------------------------------------------------
// Platform & intelligence (§4 "Platform & intelligence", §8, §9, §20)
// ---------------------------------------------------------------------------

model CustomFieldDefinition {
  id           String                @id @default(cuid())
  entityType   CustomFieldEntityType
  fieldKey     String
  label        String
  dataType     CustomFieldDataType
  options      Json?
  required     Boolean               @default(false)
  displayOrder Int                   @default(0)
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  values CustomFieldValue[]

  @@unique([entityType, fieldKey])
  @@map("custom_field_definitions")
}

// Polymorphic (entityType, entityId) reference (Fig. 4) — value is stored as
// JSONB but mirrored into typed columns so reports can filter/sort on it (§8).
model CustomFieldValue {
  id                String                @id @default(cuid())
  fieldDefinitionId String
  fieldDefinition   CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id])
  entityType        CustomFieldEntityType
  entityId          String
  value             Json
  valueText         String?
  valueNumber       Decimal?              @db.Decimal(18, 4)
  valueDate         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([fieldDefinitionId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("custom_field_values")
}

model ReportDefinition {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  entity    String
  config    Json
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("report_definitions")
}

// The allow-list the Reporting Query Service validates every request against —
// the boundary between the UI and raw SQL (§9).
model ReportFieldCatalogEntry {
  id         String  @id @default(cuid())
  entity     String
  fieldKey   String
  label      String
  dataType   String
  aggregable Boolean @default(false)
  joinPath   String?
  active     Boolean @default(true)

  @@unique([entity, fieldKey])
  @@map("report_field_catalog")
}

model Automation {
  id           String   @id @default(cuid())
  name         String
  triggerEvent String
  conditions   Json?
  actions      Json
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events AutomationEvent[]

  @@map("automations")
}

model AutomationEvent {
  id            String     @id @default(cuid())
  automationId  String
  automation    Automation @relation(fields: [automationId], references: [id])
  entityType    String
  entityId      String
  result        String
  detail        Json?
  firedAt       DateTime   @default(now())
  triggeredById String?
  triggeredBy   User?      @relation("TriggeredByUser", fields: [triggeredById], references: [id])

  @@index([automationId])
  @@map("automation_events")
}

// Generic audit trail, polymorphic like CustomFieldValue (§15).
model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}
